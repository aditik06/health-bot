# Copy this file to .env and fill in your key to enable the AI chat feature.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional - defaults to claude-opus-5
# ANTHROPIC_CHAT_MODEL=claude-opus-5

# Optional - enables email verification on signup. Without all three of
# these set, new accounts are auto-verified and verification links are only
# logged to the server console (fine for local dev, not for production).
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
# Optional - defaults to 587
# SMTP_PORT=587
# Optional - defaults to SMTP_USER
# SMTP_FROM=noreply@yourdomain.com

# Optional - base URL used to build the link in verification emails.
# Defaults to http://localhost:<PORT>; set this to your real domain in
# production or the emailed link will point at localhost.
# APP_URL=https://yourdomain.com
